diff --git a/css/chat.css b/css/chat.css
new file mode 100644
index 0000000..c21e8ad
--- /dev/null
+++ b/css/chat.css
@@ -0,0 +1,473 @@
+/* ============================================================
+   THESMALLBOOK — 💬 CHAT PAGE (chat.css)
+   Full-screen chat interface. Replaces the popup widget.
+   Reference language: dark canvas, bubbles, colour-block sources,
+   pill suggestion chips, docked composer above the action bar.
+   ============================================================ */
+
+body.chatpage {
+  min-height: 100dvh;
+  display: flex;
+  flex-direction: column;
+  background: var(--surface-0);
+  background-image: none;
+}
+
+/* ---------- top bar ---------- */
+.chat-top {
+  position: sticky;
+  top: 0;
+  z-index: var(--z-sticky);
+  display: flex;
+  align-items: center;
+  gap: var(--s-3);
+  padding: calc(var(--safe-t) + var(--s-3)) var(--gutter) var(--s-3);
+  background: color-mix(in srgb, var(--surface-0) 90%, transparent);
+  backdrop-filter: saturate(160%) blur(12px);
+  -webkit-backdrop-filter: saturate(160%) blur(12px);
+  border-bottom: var(--border-soft);
+}
+.chat-top__back,
+.chat-top__new {
+  flex: 0 0 auto;
+  display: grid;
+  place-items: center;
+  width: 40px; height: 40px;
+  background: var(--surface-inset);
+  border: var(--border-soft);
+  border-radius: var(--r-pill);
+  color: var(--text-1);
+  cursor: pointer;
+  text-decoration: none;
+  transition: transform var(--dur-2) var(--ease-spring);
+}
+.chat-top__back:active,
+.chat-top__new:active { transform: scale(.92); }
+.chat-top__back svg,
+.chat-top__new svg { width: 20px; height: 20px; }
+
+.chat-top__title { flex: 1 1 auto; min-width: 0; }
+.chat-top__title h1 {
+  font-family: var(--font-head);
+  font-size: var(--fs-lg);
+  line-height: 1.1;
+  text-transform: uppercase;
+  letter-spacing: var(--tracking-head);
+  color: var(--text-1);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+.chat-top__title span {
+  display: block;
+  font-size: var(--fs-2xs);
+  font-weight: 600;
+  color: var(--text-3);
+  letter-spacing: .3px;
+}
+
+/* ---------- message log ---------- */
+.chat-log {
+  flex: 1 1 auto;
+  display: flex;
+  flex-direction: column;
+  gap: var(--s-4);
+  width: 100%;
+  max-width: 760px;
+  margin-inline: auto;
+  padding: var(--s-5) var(--gutter) var(--s-4);
+  overflow-y: auto;
+  -webkit-overflow-scrolling: touch;
+}
+
+.chat-msg { display: flex; gap: var(--s-3); max-width: 100%; }
+.chat-msg--me { flex-direction: row-reverse; }
+
+.chat-av {
+  flex: 0 0 auto;
+  display: grid;
+  place-items: center;
+  width: 32px; height: 32px;
+  border-radius: var(--r-pill);
+  background: var(--tsb-butter);
+  font-size: 15px;
+  line-height: 1;
+}
+.chat-msg--me .chat-av { background: var(--tsb-periwinkle); color: #fff; }
+
+.chat-bubble {
+  max-width: min(100%, 560px);
+  padding: var(--s-4) var(--s-4);
+  border-radius: var(--r-lg);
+  background: var(--surface-1);
+  box-shadow: var(--shadow-1);
+  font-size: var(--fs-sm);
+  line-height: var(--lh-body);
+  color: var(--text-1);
+  overflow-wrap: anywhere;
+}
+.chat-msg--me .chat-bubble {
+  background: var(--tsb-periwinkle);
+  color: #fff;
+  border-bottom-right-radius: var(--r-xs);
+}
+.chat-msg--bot .chat-bubble { border-bottom-left-radius: var(--r-xs); }
+
+.chat-answer__tag {
+  display: inline-block;
+  margin-bottom: var(--s-2);
+  padding: 3px 10px;
+  background: var(--tsb-butter);
+  color: var(--tsb-black);
+  border-radius: var(--r-pill);
+  font-size: var(--fs-2xs);
+  font-weight: 700;
+  letter-spacing: var(--tracking-caps);
+  text-transform: uppercase;
+}
+
+/* ---------- source cards ---------- */
+.chat-srcs { display: flex; flex-direction: column; gap: var(--s-2); margin-top: var(--s-3); }
+
+.chat-src {
+  display: flex;
+  align-items: center;
+  gap: var(--s-3);
+  padding: var(--s-3);
+  border-radius: var(--r-md);
+  background: var(--surface-2);
+  border: var(--border-soft);
+  color: var(--text-1);
+  text-decoration: none;
+  transition: transform var(--dur-2) var(--ease-out), box-shadow var(--dur-2) var(--ease);
+}
+.chat-src:active { transform: scale(.985); }
+.chat-src:hover { box-shadow: var(--shadow-2); }
+
+.chat-src__cover {
+  flex: 0 0 auto;
+  width: 38px; height: 54px;
+  object-fit: cover;
+  border-radius: var(--r-xs);
+  background: var(--surface-inset);
+}
+.chat-src__ico {
+  flex: 0 0 auto;
+  display: grid;
+  place-items: center;
+  width: 38px; height: 54px;
+  border-radius: var(--r-xs);
+  background: #2A1315;
+  font-size: 19px;
+}
+.chat-src__txt { flex: 1 1 auto; min-width: 0; }
+.chat-src__book {
+  display: block;
+  font-size: var(--fs-2xs);
+  font-weight: 700;
+  letter-spacing: .4px;
+  text-transform: uppercase;
+  color: var(--text-3);
+}
+.chat-src__lesson {
+  display: block;
+  font-weight: 700;
+  font-size: var(--fs-sm);
+  line-height: 1.25;
+  margin: 1px 0 2px;
+}
+.chat-src__blurb {
+  display: block;
+  font-size: var(--fs-xs);
+  line-height: 1.35;
+  color: var(--text-2);
+  display: -webkit-box;
+  -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+.chat-src__go {
+  flex: 0 0 auto;
+  display: grid;
+  place-items: center;
+  width: 28px; height: 28px;
+  border-radius: var(--r-pill);
+  background: var(--tsb-coral);
+  color: #fff;
+}
+.chat-src__go svg { width: 14px; height: 14px; stroke-width: 2.6; }
+.chat-src--grave .chat-src__go { background: #8B2020; }
+
+/* ---------- typing indicator ---------- */
+.chat-typing { display: flex; gap: 5px; padding: 4px 2px; }
+.chat-typing i {
+  width: 7px; height: 7px;
+  border-radius: var(--r-pill);
+  background: var(--text-3);
+  animation: chat-bounce 1.2s infinite ease-in-out;
+}
+.chat-typing i:nth-child(2) { animation-delay: .15s; }
+.chat-typing i:nth-child(3) { animation-delay: .3s; }
+@keyframes chat-bounce {
+  0%, 60%, 100% { transform: translateY(0); opacity: .45; }
+  30%           { transform: translateY(-5px); opacity: 1; }
+}
+
+/* ---------- welcome ---------- */
+.chat-hello { text-align: center; padding: var(--s-8) var(--s-2) var(--s-4); }
+.chat-hello__mark {
+  width: 62px; height: 62px;
+  margin: 0 auto var(--s-4);
+  display: grid; place-items: center;
+  background: var(--tsb-butter);
+  border-radius: var(--r-lg);
+  font-size: 30px;
+}
+.chat-hello h2 {
+  font-family: var(--font-head);
+  font-size: var(--fs-2xl);
+  line-height: var(--lh-tight);
+  text-transform: uppercase;
+  letter-spacing: var(--tracking-head);
+  color: var(--text-1);
+  margin-bottom: var(--s-2);
+}
+.chat-hello p {
+  font-size: var(--fs-sm);
+  color: var(--text-2);
+  max-width: 40ch;
+  margin-inline: auto;
+}
+
+/* ---------- suggestion chips ---------- */
+.chat-suggest {
+  display: flex;
+  gap: var(--s-2);
+  overflow-x: auto;
+  scrollbar-width: none;
+  padding: 0 var(--gutter) var(--s-3);
+  width: 100%;
+  max-width: 760px;
+  margin-inline: auto;
+}
+.chat-suggest::-webkit-scrollbar { display: none; }
+.chat-suggest button {
+  flex: 0 0 auto;
+  height: 36px;
+  padding: 0 var(--s-4);
+  background: var(--surface-1);
+  border: var(--border-soft);
+  border-radius: var(--r-pill);
+  color: var(--text-1);
+  font-family: var(--font-body);
+  font-size: var(--fs-xs);
+  font-weight: 600;
+  white-space: nowrap;
+  cursor: pointer;
+  transition: transform var(--dur-2) var(--ease-spring);
+}
+.chat-suggest button:active { transform: scale(.94); }
+
+/* ---------- composer ---------- */
+.chat-dock {
+  position: sticky;
+  bottom: 0;
+  z-index: var(--z-sticky);
+  width: 100%;
+  padding: var(--s-3) var(--gutter)
+           calc(var(--bar-total) + var(--s-4));
+  background: linear-gradient(to top,
+    var(--surface-0) 62%, transparent);
+}
+.chat-dock__in {
+  display: flex;
+  align-items: center;
+  gap: var(--s-2);
+  max-width: 760px;
+  margin-inline: auto;
+  padding: var(--s-2) var(--s-2) var(--s-2) var(--s-5);
+  background: var(--surface-1);
+  border: var(--border-soft);
+  border-radius: var(--r-pill);
+  box-shadow: var(--shadow-2);
+}
+.chat-dock__in input {
+  flex: 1 1 auto;
+  min-width: 0;
+  height: 40px;
+  background: none;
+  border: 0;
+  outline: none;
+  color: var(--text-1);
+  font-family: var(--font-body);
+  font-size: var(--fs-md);   /* >=16px avoids iOS zoom-on-focus */
+}
+.chat-dock__in input::placeholder { color: var(--text-3); }
+#chatSend {
+  flex: 0 0 auto;
+  display: grid;
+  place-items: center;
+  width: 44px; height: 44px;
+  background: var(--tsb-coral);
+  border: 0;
+  border-radius: var(--r-pill);
+  color: #fff;
+  cursor: pointer;
+  transition: transform var(--dur-2) var(--ease-spring), opacity var(--dur-2) var(--ease);
+}
+#chatSend:active { transform: scale(.9); }
+#chatSend:disabled { opacity: .4; cursor: not-allowed; }
+#chatSend svg { width: 20px; height: 20px; }
+
+/* the chat page owns its own scroll — bar spacing handled by the dock */
+body.chatpage.tsb-has-bar { padding-bottom: 0; }
+
+
+/* ============================================================
+   QUESTION LIBRARY SHEET
+   ============================================================ */
+.qlib {
+  position: fixed;
+  inset: 0;
+  z-index: var(--z-sheet);
+  display: flex;
+  align-items: flex-end;
+  justify-content: center;
+  background: rgba(0,0,0,.55);
+  backdrop-filter: blur(3px);
+  -webkit-backdrop-filter: blur(3px);
+  animation: qlib-fade var(--dur-2) var(--ease);
+}
+@keyframes qlib-fade { from { opacity: 0 } to { opacity: 1 } }
+
+.qlib__box {
+  display: flex;
+  flex-direction: column;
+  width: min(100%, 560px);
+  height: 88dvh;
+  padding: var(--s-4) var(--gutter) calc(var(--safe-b) + var(--s-4));
+  background: var(--surface-1);
+  border-radius: var(--r-xl) var(--r-xl) 0 0;
+  animation: qlib-up var(--dur-3) var(--ease-out);
+}
+@keyframes qlib-up { from { transform: translateY(100%) } to { transform: translateY(0) } }
+
+.qlib__grab {
+  width: 40px; height: 4px;
+  margin: 0 auto var(--s-4);
+  border-radius: var(--r-pill);
+  background: var(--text-3);
+  opacity: .35;
+  flex: 0 0 auto;
+}
+.qlib__head {
+  flex: 0 0 auto;
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: var(--s-3);
+  margin-bottom: var(--s-3);
+}
+.qlib__head h2 {
+  font-family: var(--font-head);
+  font-size: var(--fs-xl);
+  text-transform: uppercase;
+  letter-spacing: var(--tracking-head);
+  color: var(--text-1);
+}
+.qlib__head span { font-size: var(--fs-2xs); font-weight: 700; color: var(--text-3); }
+
+.qlib__search {
+  flex: 0 0 auto;
+  width: 100%;
+  min-height: 46px;
+  margin-bottom: var(--s-3);
+  padding: 0 var(--s-4);
+  background: var(--surface-inset);
+  border: 2px solid transparent;
+  border-radius: var(--r-md);
+  color: var(--text-1);
+  font-family: var(--font-body);
+  font-size: var(--fs-md);
+  outline: none;
+}
+.qlib__search:focus { border-color: var(--tsb-periwinkle); }
+
+.qlib__tabs {
+  flex: 0 0 auto;
+  display: flex;
+  gap: var(--s-2);
+  overflow-x: auto;
+  scrollbar-width: none;
+  padding-bottom: var(--s-3);
+}
+.qlib__tabs::-webkit-scrollbar { display: none }
+.qlib__tab {
+  flex: 0 0 auto;
+  height: 34px;
+  padding: 0 var(--s-4);
+  background: var(--surface-inset);
+  border: 0;
+  border-radius: var(--r-pill);
+  color: var(--text-2);
+  font-family: var(--font-body);
+  font-size: var(--fs-xs);
+  font-weight: 700;
+  white-space: nowrap;
+  cursor: pointer;
+  transition: background var(--dur-2) var(--ease), color var(--dur-2) var(--ease);
+}
+.qlib__tab.is-on { background: var(--tsb-mint); color: var(--tsb-black); }
+
+.qlib__list {
+  flex: 1 1 auto;
+  min-height: 0;
+  overflow-y: auto;
+  -webkit-overflow-scrolling: touch;
+  overscroll-behavior: contain;
+  display: flex;
+  flex-direction: column;
+  gap: var(--s-2);
+  padding-bottom: var(--s-4);
+}
+.qlib__group {
+  position: sticky;
+  top: 0;
+  z-index: 1;
+  padding: var(--s-3) 0 var(--s-2);
+  background: var(--surface-1);
+  font-family: var(--font-head);
+  font-size: var(--fs-xs);
+  text-transform: uppercase;
+  letter-spacing: var(--tracking-caps);
+  color: var(--text-3);
+}
+.qlib__q {
+  display: flex;
+  align-items: center;
+  gap: var(--s-3);
+  width: 100%;
+  min-height: 50px;
+  padding: var(--s-3) var(--s-4);
+  background: var(--surface-2);
+  border: var(--border-soft);
+  border-radius: var(--r-md);
+  color: var(--text-1);
+  font-family: var(--font-body);
+  font-size: var(--fs-sm);
+  font-weight: 600;
+  line-height: 1.35;
+  text-align: left;
+  cursor: pointer;
+  transition: transform var(--dur-2) var(--ease-out);
+}
+.qlib__q:active { transform: scale(.985); }
+.qlib__q b { flex: 1 1 auto; font-weight: 600; }
+.qlib__q small {
+  flex: 0 0 auto;
+  font-size: var(--fs-2xs);
+  font-weight: 700;
+  color: var(--text-3);
+  white-space: nowrap;
+}
+.qlib__empty { padding: var(--s-8) var(--s-4); text-align: center; color: var(--text-3); font-size: var(--fs-sm); }
diff --git a/css/feed.css b/css/feed.css
new file mode 100644
index 0000000..84a542b
--- /dev/null
+++ b/css/feed.css
@@ -0,0 +1,281 @@
+/* ============================================================
+   THESMALLBOOK — 🏠 FEED (feed.css)
+   Colour-block cards, graveyard as a first-class citizen.
+   GPU-friendly: transform/opacity only, content-visibility on
+   long lists so 400+ cards stay at 60/120fps.
+   ============================================================ */
+
+.fd-wrap {
+  width: 100%;
+  max-width: 640px;
+  margin-inline: auto;
+  padding: var(--s-4) var(--gutter) calc(var(--bar-total) + var(--s-10));
+  display: flex;
+  flex-direction: column;
+  gap: var(--s-4);
+}
+.fd-batch { display: contents; }
+
+/* ---------- base card ---------- */
+.fd-card {
+  position: relative;
+  display: block;
+  padding: var(--s-5);
+  border-radius: var(--r-lg);
+  background: var(--surface-1);
+  box-shadow: var(--shadow-2);
+  cursor: pointer;
+  overflow: hidden;
+  isolation: isolate;
+
+  /* perf: skip layout/paint for offscreen cards */
+  content-visibility: auto;
+  contain-intrinsic-size: auto 260px;
+
+  transition: transform var(--dur-2) var(--ease-out);
+  will-change: transform;
+}
+.fd-card:active { transform: scale(.985); }
+
+.fd-card--coral      { background: var(--tsb-coral);      color: #fff; }
+.fd-card--periwinkle { background: var(--tsb-periwinkle); color: #fff; }
+.fd-card--butter     { background: var(--tsb-butter);     color: var(--tsb-black); }
+.fd-card--mint       { background: var(--tsb-mint);       color: var(--tsb-black); }
+.fd-card--sky        { background: var(--tsb-sky);        color: var(--tsb-black); }
+.fd-card--plain      { background: var(--surface-1);      color: var(--text-1); }
+
+/* ---------- graveyard: unmistakable, still premium ---------- */
+.fd-card--grave {
+  background:
+    radial-gradient(120% 90% at 50% -20%, #3A1418 0%, transparent 60%),
+    linear-gradient(165deg, #241014 0%, #17090C 60%, #120709 100%);
+  color: #F3E6E6;
+  border: 1px solid rgba(255, 90, 71, .20);
+}
+.fd-card--grave::before {
+  content: "";
+  position: absolute;
+  inset: 0;
+  background-image:
+    repeating-linear-gradient(90deg, rgba(255,255,255,.028) 0 1px, transparent 1px 4px);
+  pointer-events: none;
+  z-index: -1;
+}
+.fd-rip {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--s-3);
+  margin-bottom: var(--s-3);
+}
+.fd-rip__tag {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  padding: 4px 11px;
+  background: rgba(255, 90, 71, .16);
+  border: 1px solid rgba(255, 90, 71, .34);
+  border-radius: var(--r-pill);
+  color: #FF8A7A;
+  font-size: var(--fs-2xs);
+  font-weight: 800;
+  letter-spacing: 1.4px;
+}
+.fd-rip__yr {
+  font-family: var(--font-head);
+  font-size: var(--fs-sm);
+  color: rgba(243, 230, 230, .45);
+  letter-spacing: 1px;
+}
+.fd-title--grave { color: #fff; }
+.fd-sub {
+  font-size: var(--fs-sm);
+  line-height: 1.35;
+  color: rgba(243, 230, 230, .74);
+  margin-bottom: var(--s-3);
+}
+.fd-loss {
+  display: inline-block;
+  margin-bottom: var(--s-3);
+  padding: 6px 12px;
+  background: rgba(255, 90, 71, .12);
+  border-left: 3px solid var(--tsb-coral);
+  border-radius: 0 8px 8px 0;
+  font-size: var(--fs-xs);
+  font-weight: 700;
+  color: #FFB3A6;
+}
+.fd-card--grave .fd-body { color: rgba(243, 230, 230, .62); }
+.fd-card--grave .fd-act { color: rgba(243, 230, 230, .60); border-color: rgba(255,255,255,.12); }
+.fd-card--grave .fd-act.on { color: var(--tsb-coral); border-color: rgba(255,90,71,.42); }
+.fd-card--grave .fd-go { background: rgba(255, 90, 71, .92); color: #fff; }
+
+/* ---------- shared bits ---------- */
+.fd-eyebrow {
+  display: block;
+  font-size: var(--fs-2xs);
+  font-weight: 800;
+  letter-spacing: var(--tracking-caps);
+  text-transform: uppercase;
+  opacity: .68;
+  margin-bottom: var(--s-2);
+}
+.fd-title {
+  font-family: var(--font-head);
+  font-size: var(--fs-lg);
+  line-height: 1.18;
+  letter-spacing: .3px;
+  margin-bottom: var(--s-2);
+}
+.fd-body {
+  font-size: var(--fs-sm);
+  line-height: 1.48;
+  opacity: .88;
+  display: -webkit-box;
+  -webkit-line-clamp: 3;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+.fd-src {
+  display: block;
+  margin-top: var(--s-3);
+  font-size: var(--fs-2xs);
+  font-weight: 700;
+  letter-spacing: .4px;
+  text-transform: uppercase;
+  opacity: .58;
+}
+
+.fd-quote {
+  font-family: var(--font-head);
+  font-size: clamp(1.12rem, .98rem + .8vw, 1.5rem);
+  line-height: 1.28;
+  letter-spacing: .2px;
+  margin-bottom: var(--s-4);
+  padding-right: 34px;
+}
+.fd-by {
+  display: flex;
+  align-items: center;
+  gap: var(--s-3);
+  padding-top: var(--s-3);
+  border-top: 1px solid currentColor;
+  border-color: color-mix(in srgb, currentColor 22%, transparent);
+}
+.fd-by img { flex: 0 0 auto; width: 30px; height: 44px; object-fit: cover; border-radius: 5px; }
+.fd-by span { font-size: var(--fs-2xs); line-height: 1.35; opacity: .8; }
+.fd-by b { display: block; font-size: var(--fs-xs); opacity: 1; }
+
+.fd-row { display: flex; gap: var(--s-4); }
+.fd-cover {
+  flex: 0 0 auto;
+  width: 62px; height: 92px;
+  object-fit: cover;
+  border-radius: var(--r-xs);
+  background: var(--surface-inset);
+  box-shadow: 0 3px 10px rgba(0,0,0,.16);
+}
+.fd-rowtxt { flex: 1 1 auto; min-width: 0; }
+
+/* ---------- actions ---------- */
+.fd-acts {
+  display: flex;
+  gap: var(--s-2);
+  margin-top: var(--s-4);
+  padding-top: var(--s-3);
+  border-top: 1px solid color-mix(in srgb, currentColor 14%, transparent);
+}
+.fd-act {
+  display: grid;
+  place-items: center;
+  width: 38px; height: 38px;
+  background: transparent;
+  border: 1px solid color-mix(in srgb, currentColor 20%, transparent);
+  border-radius: var(--r-pill);
+  color: inherit;
+  opacity: .72;
+  cursor: pointer;
+  transition: opacity var(--dur-2) var(--ease), transform var(--dur-1) var(--ease);
+}
+.fd-act svg { width: 18px; height: 18px; }
+.fd-act:active { transform: scale(.9); }
+.fd-act.on {
+  opacity: 1;
+  color: var(--tsb-coral);
+  border-color: color-mix(in srgb, var(--tsb-coral) 45%, transparent);
+  background: color-mix(in srgb, var(--tsb-coral) 12%, transparent);
+}
+.fd-act.on svg { fill: currentColor; }
+.fd-card--coral .fd-act.on,
+.fd-card--periwinkle .fd-act.on { color: #fff; border-color: rgba(255,255,255,.5); background: rgba(255,255,255,.18); }
+
+.fd-go {
+  position: absolute;
+  top: var(--s-4);
+  right: var(--s-4);
+  display: grid;
+  place-items: center;
+  width: 32px; height: 32px;
+  background: color-mix(in srgb, var(--surface-2) 92%, transparent);
+  color: var(--text-1);
+  border-radius: var(--r-pill);
+  text-decoration: none;
+  transition: transform var(--dur-2) var(--ease-spring);
+}
+.fd-go:active { transform: scale(.88) rotate(10deg); }
+.fd-go svg { width: 15px; height: 15px; }
+.fd-card--coral .fd-go,
+.fd-card--periwinkle .fd-go { background: rgba(255,255,255,.92); color: #111; }
+
+/* ---------- infinite sentinel ---------- */
+.fd-sentinel { display: grid; place-items: center; padding: var(--s-8) 0; }
+.fd-spin {
+  width: 26px; height: 26px;
+  border: 3px solid var(--surface-inset);
+  border-top-color: var(--tsb-coral);
+  border-radius: 50%;
+  animation: fd-spin .8s linear infinite;
+}
+@keyframes fd-spin { to { transform: rotate(360deg); } }
+
+/* ---------- feed header ---------- */
+.fd-head {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: var(--s-3);
+  padding: var(--s-2) 0 0;
+}
+.fd-head h2 {
+  font-family: var(--font-head);
+  font-size: var(--fs-2xl);
+  line-height: 1.1;
+  text-transform: uppercase;
+  letter-spacing: var(--tracking-head);
+  color: var(--text-1);
+}
+.fd-head p { font-size: var(--fs-xs); color: var(--text-3); margin-top: 4px; }
+
+@media (prefers-reduced-motion: reduce) {
+  .fd-card { transition: none; }
+  .fd-spin { animation-duration: 2.4s; }
+}
+
+/* ---- homepage: hand-off from the feed down to the full shelf ---- */
+.fd-more { text-align: center; margin: 8px auto 46px; }
+.fd-morebtn {
+  display: inline-block;
+  padding: 13px 26px;
+  border: 2px solid var(--ink, #0E0E10);
+  border-radius: 999px;
+  background: transparent;
+  color: var(--ink, #0E0E10);
+  font-weight: 700;
+  font-size: .95rem;
+  text-decoration: none;
+  transition: transform .18s ease, background .18s ease, color .18s ease;
+}
+.fd-morebtn:hover { transform: translateY(-2px); background: var(--ink, #0E0E10); color: #fff; }
+html.dark .fd-morebtn { border-color: rgba(255,255,255,.55); color: #f2f2f2; }
+html.dark .fd-morebtn:hover { background: #fff; color: #0E0E10; }
+@media (prefers-reduced-motion: reduce) { .fd-morebtn { transition: none; } }
diff --git a/css/profile.css b/css/profile.css
new file mode 100644
index 0000000..82ebc31
--- /dev/null
+++ b/css/profile.css
@@ -0,0 +1,649 @@
+/* ============================================================
+   THESMALLBOOK — 👤 PROFILE + ⚙️ SETTINGS (profile.css)
+   ============================================================ */
+
+body.profilepage,
+body.settingspage {
+  background: var(--surface-0);
+  background-image: none;
+  min-height: 100dvh;
+}
+
+/* ---------- top bar ---------- */
+.pf-top {
+  position: sticky;
+  top: 0;
+  z-index: var(--z-sticky);
+  display: flex;
+  align-items: center;
+  gap: var(--s-3);
+  padding: calc(var(--safe-t) + var(--s-3)) var(--gutter) var(--s-3);
+  background: color-mix(in srgb, var(--surface-0) 90%, transparent);
+  backdrop-filter: saturate(160%) blur(12px);
+  -webkit-backdrop-filter: saturate(160%) blur(12px);
+  border-bottom: var(--border-soft);
+}
+.pf-top h1 {
+  flex: 1 1 auto;
+  font-family: var(--font-head);
+  font-size: var(--fs-xl);
+  text-transform: uppercase;
+  letter-spacing: var(--tracking-head);
+  color: var(--text-1);
+}
+.pf-top__back, .pf-top__cog {
+  flex: 0 0 auto;
+  display: grid;
+  place-items: center;
+  width: 40px; height: 40px;
+  background: var(--surface-inset);
+  border: var(--border-soft);
+  border-radius: var(--r-pill);
+  color: var(--text-1);
+  text-decoration: none;
+  cursor: pointer;
+  transition: transform var(--dur-2) var(--ease-spring);
+}
+.pf-top__back:active, .pf-top__cog:active { transform: scale(.92); }
+.pf-top__back svg, .pf-top__cog svg { width: 20px; height: 20px; }
+
+.pf-wrap {
+  width: 100%;
+  max-width: 720px;
+  margin-inline: auto;
+  padding: var(--s-5) var(--gutter) calc(var(--bar-total) + var(--s-10));
+  display: flex;
+  flex-direction: column;
+  gap: var(--s-4);
+}
+.pf-loading { display: flex; flex-direction: column; gap: var(--s-4); }
+
+/* ============================================================
+   SIGNED-OUT STATE
+   ============================================================ */
+.pf-gate {
+  text-align: center;
+  padding: var(--s-10) var(--s-5);
+  background: var(--surface-1);
+  border-radius: var(--r-lg);
+  box-shadow: var(--shadow-1);
+}
+.pf-gate__mark {
+  width: 72px; height: 72px;
+  margin: 0 auto var(--s-5);
+  display: grid; place-items: center;
+  background: var(--tsb-butter);
+  border-radius: var(--r-lg);
+  font-size: 34px;
+}
+.pf-gate h2 {
+  font-family: var(--font-head);
+  font-size: var(--fs-2xl);
+  line-height: var(--lh-tight);
+  text-transform: uppercase;
+  letter-spacing: var(--tracking-head);
+  color: var(--text-1);
+  margin-bottom: var(--s-3);
+}
+.pf-gate p {
+  font-size: var(--fs-sm);
+  color: var(--text-2);
+  max-width: 34ch;
+  margin: 0 auto var(--s-6);
+}
+.pf-gate__list {
+  list-style: none;
+  text-align: left;
+  max-width: 300px;
+  margin: 0 auto var(--s-6);
+  display: flex;
+  flex-direction: column;
+  gap: var(--s-3);
+}
+.pf-gate__list li {
+  display: flex;
+  gap: var(--s-3);
+  align-items: flex-start;
+  font-size: var(--fs-sm);
+  color: var(--text-1);
+}
+.pf-gate__list span { flex: 0 0 auto; font-size: 17px; line-height: 1.3; }
+
+/* ---------- buttons ---------- */
+.pf-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: var(--s-2);
+  width: 100%;
+  min-height: 50px;
+  padding: 0 var(--s-5);
+  border: 0;
+  border-radius: var(--r-md);
+  font-family: var(--font-body);
+  font-size: var(--fs-md);
+  font-weight: 700;
+  cursor: pointer;
+  text-decoration: none;
+  transition: transform var(--dur-2) var(--ease-spring), box-shadow var(--dur-2) var(--ease);
+}
+.pf-btn:active { transform: scale(.97); }
+.pf-btn--primary { background: var(--tsb-coral); color: #fff; box-shadow: 0 4px 14px rgba(255,90,71,.35); }
+.pf-btn--ghost   { background: var(--surface-inset); color: var(--text-1); border: var(--border-soft); }
+.pf-btn--danger  { background: transparent; color: var(--danger); border: 2px solid var(--danger); }
+.pf-btn svg { width: 19px; height: 19px; }
+
+/* ============================================================
+   SIGNED-IN HEADER
+   ============================================================ */
+.pf-hero {
+  display: flex;
+  align-items: center;
+  gap: var(--s-4);
+  padding: var(--s-5);
+  background: var(--surface-1);
+  border-radius: var(--r-lg);
+  box-shadow: var(--shadow-1);
+}
+.pf-ava {
+  position: relative;
+  flex: 0 0 auto;
+  width: 76px; height: 76px;
+  border-radius: var(--r-pill);
+  background: var(--tsb-periwinkle);
+  display: grid;
+  place-items: center;
+  overflow: hidden;
+  cursor: pointer;
+}
+.pf-ava img { width: 100%; height: 100%; object-fit: cover; }
+.pf-ava__ini {
+  font-family: var(--font-head);
+  font-size: 1.6rem;
+  color: #fff;
+  letter-spacing: 1px;
+}
+.pf-ava__edit {
+  position: absolute;
+  right: -2px; bottom: -2px;
+  width: 28px; height: 28px;
+  display: grid; place-items: center;
+  background: var(--tsb-coral);
+  color: #fff;
+  border: 3px solid var(--surface-1);
+  border-radius: var(--r-pill);
+}
+.pf-ava__edit svg { width: 13px; height: 13px; }
+.pf-ava.is-busy { opacity: .55; pointer-events: none; }
+
+.pf-id { flex: 1 1 auto; min-width: 0; }
+.pf-id__name {
+  font-family: var(--font-head);
+  font-size: var(--fs-lg);
+  line-height: 1.15;
+  color: var(--text-1);
+  word-break: break-word;
+}
+.pf-id__handle {
+  font-size: var(--fs-sm);
+  font-weight: 600;
+  color: var(--tsb-coral);
+  margin-top: 2px;
+  word-break: break-all;
+}
+.pf-id__bio {
+  font-size: var(--fs-xs);
+  color: var(--text-2);
+  margin-top: var(--s-2);
+  line-height: 1.4;
+}
+
+/* ---------- counters ---------- */
+.pf-counts {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: var(--s-2);
+}
+.pf-count {
+  padding: var(--s-4) var(--s-2);
+  text-align: center;
+  background: var(--surface-1);
+  border-radius: var(--r-md);
+  box-shadow: var(--shadow-1);
+}
+.pf-count b {
+  display: block;
+  font-family: var(--font-head);
+  font-size: var(--fs-xl);
+  line-height: 1;
+  color: var(--text-1);
+}
+.pf-count span {
+  display: block;
+  margin-top: 4px;
+  font-size: var(--fs-2xs);
+  font-weight: 700;
+  letter-spacing: var(--tracking-caps);
+  text-transform: uppercase;
+  color: var(--text-3);
+}
+
+/* ---------- stat colour blocks ---------- */
+.pf-stats { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-3); }
+.pf-stat {
+  padding: var(--s-5);
+  border-radius: var(--r-lg);
+  box-shadow: var(--shadow-2);
+}
+.pf-stat b {
+  display: block;
+  font-family: var(--font-head);
+  font-size: var(--fs-2xl);
+  line-height: 1;
+}
+.pf-stat span {
+  display: block;
+  margin-top: var(--s-2);
+  font-size: var(--fs-2xs);
+  font-weight: 700;
+  letter-spacing: var(--tracking-caps);
+  text-transform: uppercase;
+  opacity: .78;
+}
+.pf-stat--coral  { background: var(--tsb-coral);      color: #fff; }
+.pf-stat--peri   { background: var(--tsb-periwinkle); color: #fff; }
+.pf-stat--butter { background: var(--tsb-butter);     color: var(--tsb-black); }
+.pf-stat--mint   { background: var(--tsb-mint);       color: var(--tsb-black); }
+
+/* ---------- rows ---------- */
+.pf-rows {
+  background: var(--surface-1);
+  border-radius: var(--r-lg);
+  box-shadow: var(--shadow-1);
+  overflow: hidden;
+}
+.pf-row {
+  display: flex;
+  align-items: center;
+  gap: var(--s-3);
+  width: 100%;
+  padding: var(--s-4) var(--s-5);
+  background: none;
+  border: 0;
+  border-bottom: var(--border-soft);
+  color: var(--text-1);
+  font-family: var(--font-body);
+  font-size: var(--fs-sm);
+  font-weight: 600;
+  text-align: left;
+  text-decoration: none;
+  cursor: pointer;
+}
+.pf-row:last-child { border-bottom: 0; }
+.pf-row:active { background: var(--surface-inset); }
+.pf-row__ico {
+  flex: 0 0 auto;
+  width: 34px; height: 34px;
+  display: grid; place-items: center;
+  border-radius: var(--r-sm);
+  background: var(--surface-inset);
+  font-size: 16px;
+}
+.pf-row__txt { flex: 1 1 auto; min-width: 0; }
+.pf-row__txt small {
+  display: block;
+  font-size: var(--fs-2xs);
+  font-weight: 500;
+  color: var(--text-3);
+  margin-top: 1px;
+}
+.pf-row__go { flex: 0 0 auto; color: var(--text-3); }
+.pf-row__go svg { width: 17px; height: 17px; }
+
+.pf-section {
+  font-family: var(--font-head);
+  font-size: var(--fs-xs);
+  text-transform: uppercase;
+  letter-spacing: var(--tracking-caps);
+  color: var(--text-3);
+  margin: var(--s-4) 0 calc(var(--s-2) * -1 + var(--s-1));
+  padding-left: var(--s-2);
+}
+
+/* ============================================================
+   EDIT SHEET
+   ============================================================ */
+.pf-sheet {
+  position: fixed;
+  inset: 0;
+  z-index: var(--z-sheet);
+  display: flex;
+  align-items: flex-end;
+  justify-content: center;
+  background: rgba(0,0,0,.55);
+  backdrop-filter: blur(3px);
+  -webkit-backdrop-filter: blur(3px);
+  animation: pf-fade var(--dur-2) var(--ease);
+}
+@keyframes pf-fade { from { opacity: 0; } to { opacity: 1; } }
+
+.pf-sheet__box {
+  width: min(100%, 520px);
+  max-height: 90dvh;
+  overflow-y: auto;
+  padding: var(--s-5) var(--gutter) calc(var(--safe-b) + var(--s-6));
+  background: var(--surface-1);
+  border-radius: var(--r-xl) var(--r-xl) 0 0;
+  animation: pf-up var(--dur-3) var(--ease-out);
+}
+@keyframes pf-up { from { transform: translateY(100%); } to { transform: translateY(0); } }
+
+.pf-sheet__grab {
+  width: 40px; height: 4px;
+  margin: 0 auto var(--s-5);
+  border-radius: var(--r-pill);
+  background: var(--text-3);
+  opacity: .35;
+}
+.pf-sheet h2 {
+  font-family: var(--font-head);
+  font-size: var(--fs-xl);
+  text-transform: uppercase;
+  letter-spacing: var(--tracking-head);
+  color: var(--text-1);
+  margin-bottom: var(--s-5);
+}
+
+.pf-field { margin-bottom: var(--s-5); }
+.pf-field label {
+  display: block;
+  font-size: var(--fs-2xs);
+  font-weight: 700;
+  letter-spacing: var(--tracking-caps);
+  text-transform: uppercase;
+  color: var(--text-3);
+  margin-bottom: var(--s-2);
+}
+.pf-field input,
+.pf-field textarea {
+  width: 100%;
+  padding: var(--s-3) var(--s-4);
+  background: var(--surface-inset);
+  border: 2px solid transparent;
+  border-radius: var(--r-md);
+  color: var(--text-1);
+  font-family: var(--font-body);
+  font-size: var(--fs-md);   /* >=16px: no iOS zoom */
+  outline: none;
+  transition: border-color var(--dur-2) var(--ease);
+}
+.pf-field input:focus,
+.pf-field textarea:focus { border-color: var(--tsb-periwinkle); }
+.pf-field textarea { resize: vertical; min-height: 80px; line-height: 1.45; }
+.pf-field__hint {
+  display: block;
+  margin-top: var(--s-2);
+  font-size: var(--fs-2xs);
+  color: var(--text-3);
+}
+.pf-field__hint.is-bad { color: var(--danger); font-weight: 600; }
+.pf-field__hint.is-good { color: var(--success); font-weight: 600; }
+
+.pf-sheet__actions { display: flex; gap: var(--s-3); margin-top: var(--s-6); }
+.pf-sheet__actions .pf-btn { flex: 1 1 0; }
+
+/* ---------- toast ---------- */
+.pf-toast {
+  position: fixed;
+  left: 50%;
+  bottom: calc(var(--bar-total) + 20px);
+  transform: translateX(-50%);
+  z-index: var(--z-toast);
+  max-width: calc(100vw - 32px);
+  padding: var(--s-3) var(--s-5);
+  background: var(--tsb-slate-900);
+  color: #fff;
+  border-radius: var(--r-pill);
+  font-size: var(--fs-sm);
+  font-weight: 600;
+  box-shadow: var(--shadow-3);
+  animation: pf-toast-in var(--dur-3) var(--ease-out);
+}
+.pf-toast--bad { background: var(--danger); }
+@keyframes pf-toast-in {
+  from { opacity: 0; transform: translateX(-50%) translateY(12px); }
+  to   { opacity: 1; transform: translateX(-50%) translateY(0); }
+}
+
+/* ============================================================
+   SETTINGS-SPECIFIC
+   ============================================================ */
+.set-seg {
+  display: flex;
+  gap: var(--s-1);
+  padding: var(--s-1);
+  background: var(--surface-inset);
+  border-radius: var(--r-pill);
+}
+.set-seg button {
+  flex: 1 1 0;
+  min-height: 38px;
+  padding: 0 var(--s-3);
+  background: none;
+  border: 0;
+  border-radius: var(--r-pill);
+  color: var(--text-2);
+  font-family: var(--font-body);
+  font-size: var(--fs-xs);
+  font-weight: 700;
+  cursor: pointer;
+  transition: background var(--dur-2) var(--ease), color var(--dur-2) var(--ease);
+}
+.set-seg button.is-on {
+  background: var(--surface-1);
+  color: var(--text-1);
+  box-shadow: var(--shadow-1);
+}
+
+/* Native <select> is unstyleable in the popup layer: on Android/Windows
+   dark mode the <option> list renders white-on-white and looks invisible.
+   We keep a real <select> for a11y/forms but ALWAYS force explicit colours
+   on the options, and the language picker uses the custom sheet below. */
+.set-select {
+  width: 100%;
+  min-height: 46px;
+  padding: 0 var(--s-10) 0 var(--s-4);
+  background-color: var(--surface-inset);
+  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23888' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'><path d='M6 9l6 6 6-6'/></svg>");
+  background-repeat: no-repeat;
+  background-position: right var(--s-4) center;
+  background-size: 18px 18px;
+  border: var(--border-soft);
+  border-radius: var(--r-md);
+  color: var(--text-1);
+  font-family: var(--font-body);
+  font-size: var(--fs-md);
+  font-weight: 600;
+  cursor: pointer;
+  -webkit-appearance: none;
+  appearance: none;
+}
+/* explicit, non-variable colours — the popup layer can't see CSS vars */
+.set-select option { background: #ffffff; color: #111111; }
+html.dark .set-select option { background: #1E1E22; color: #F5F3EE; }
+
+/* ---------- custom language picker (always readable) ---------- */
+.set-picker {
+  display: flex;
+  align-items: center;
+  gap: var(--s-3);
+  width: 100%;
+  min-height: 52px;
+  padding: var(--s-2) var(--s-4);
+  background: var(--surface-inset);
+  border: var(--border-soft);
+  border-radius: var(--r-md);
+  color: var(--text-1);
+  font-family: var(--font-body);
+  font-size: var(--fs-sm);
+  font-weight: 600;
+  text-align: left;
+  cursor: pointer;
+}
+.set-picker__flag { flex: 0 0 auto; font-size: 22px; line-height: 1; }
+.set-picker__txt  { flex: 1 1 auto; min-width: 0; }
+.set-picker__txt b { display: block; font-size: var(--fs-sm); }
+.set-picker__txt small {
+  display: block;
+  font-size: var(--fs-2xs);
+  font-weight: 500;
+  color: var(--text-3);
+  margin-top: 1px;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+.set-picker__go { flex: 0 0 auto; color: var(--text-3); }
+.set-picker__go svg { width: 18px; height: 18px; }
+
+.langlist {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  max-height: 58dvh;
+  overflow-y: auto;
+  -webkit-overflow-scrolling: touch;
+  margin: 0 calc(var(--s-2) * -1);
+  padding: 0 var(--s-2);
+}
+.langlist__item {
+  display: flex;
+  align-items: center;
+  gap: var(--s-3);
+  width: 100%;
+  min-height: 54px;
+  padding: var(--s-2) var(--s-3);
+  background: none;
+  border: 0;
+  border-radius: var(--r-md);
+  color: var(--text-1);
+  font-family: var(--font-body);
+  font-size: var(--fs-sm);
+  font-weight: 600;
+  text-align: left;
+  cursor: pointer;
+}
+.langlist__item:active { background: var(--surface-inset); }
+.langlist__item.is-on { background: var(--tsb-mint); color: var(--tsb-black); }
+.langlist__item.is-on small { color: rgba(0,0,0,.62); }
+.langlist__item span.f { flex: 0 0 auto; font-size: 21px; line-height: 1; }
+.langlist__item div { flex: 1 1 auto; min-width: 0; }
+.langlist__item small {
+  display: block;
+  font-size: var(--fs-2xs);
+  font-weight: 500;
+  color: var(--text-3);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+.langlist__item .tick { flex: 0 0 auto; font-size: 15px; }
+
+.langsearch {
+  width: 100%;
+  min-height: 46px;
+  margin-bottom: var(--s-3);
+  padding: 0 var(--s-4);
+  background: var(--surface-inset);
+  border: 2px solid transparent;
+  border-radius: var(--r-md);
+  color: var(--text-1);
+  font-family: var(--font-body);
+  font-size: var(--fs-md);
+  outline: none;
+}
+.langsearch:focus { border-color: var(--tsb-periwinkle); }
+
+.set-block {
+  padding: var(--s-5);
+  background: var(--surface-1);
+  border-radius: var(--r-lg);
+  box-shadow: var(--shadow-1);
+}
+.set-block > label,
+.set-block > .set-label {
+  display: block;
+  font-size: var(--fs-2xs);
+  font-weight: 700;
+  letter-spacing: var(--tracking-caps);
+  text-transform: uppercase;
+  color: var(--text-3);
+  margin-bottom: var(--s-3);
+}
+.set-block + .set-block { margin-top: var(--s-3); }
+.set-hint {
+  margin-top: var(--s-3);
+  font-size: var(--fs-2xs);
+  color: var(--text-3);
+  line-height: 1.45;
+}
+
+/* toggle switch */
+.set-toggle {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--s-4);
+  width: 100%;
+  padding: var(--s-4) 0;
+  background: none;
+  border: 0;
+  border-bottom: var(--border-soft);
+  color: var(--text-1);
+  font-family: var(--font-body);
+  font-size: var(--fs-sm);
+  font-weight: 600;
+  text-align: left;
+  cursor: pointer;
+}
+.set-toggle:last-child { border-bottom: 0; }
+.set-toggle small {
+  display: block;
+  font-size: var(--fs-2xs);
+  font-weight: 500;
+  color: var(--text-3);
+  margin-top: 2px;
+}
+.set-sw {
+  flex: 0 0 auto;
+  position: relative;
+  width: 46px; height: 27px;
+  border-radius: var(--r-pill);
+  background: var(--surface-inset);
+  border: var(--border-soft);
+  transition: background var(--dur-2) var(--ease);
+}
+.set-sw::after {
+  content: "";
+  position: absolute;
+  top: 2px; left: 2px;
+  width: 19px; height: 19px;
+  border-radius: var(--r-pill);
+  background: var(--surface-2);
+  box-shadow: var(--shadow-1);
+  transition: transform var(--dur-2) var(--ease-spring);
+}
+.set-toggle.is-on .set-sw { background: var(--tsb-mint); }
+.set-toggle.is-on .set-sw::after { transform: translateX(19px); }
+
+/* live preview swatch row */
+.set-preview {
+  display: flex;
+  gap: var(--s-2);
+  margin-top: var(--s-4);
+}
+.set-preview i {
+  flex: 1 1 0;
+  height: 34px;
+  border-radius: var(--r-sm);
+}
diff --git a/css/shell.css b/css/shell.css
new file mode 100644
index 0000000..8efbe79
--- /dev/null
+++ b/css/shell.css
@@ -0,0 +1,404 @@
+/* ============================================================
+   THESMALLBOOK — 📱 APP SHELL (shell.css)
+   Bottom action bar + top app bar + shared app surfaces.
+   Mobile-first. Requires css/tokens.css.
+   ============================================================ */
+
+/* ============================================================
+   BOTTOM ACTION BAR — floating rounded bar, active tab in a
+   filled rounded square (reference image), coral + FAB.
+   ============================================================ */
+.tsb-bar {
+  position: fixed;
+  left: 50%;
+  bottom: calc(var(--safe-b) + 12px);
+  transform: translateX(-50%) translateZ(0);
+  z-index: var(--z-bar);
+
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 2px;
+
+  width: min(calc(100vw - 28px), 430px);
+  height: var(--bar-h);
+  padding: 7px;
+
+  /* frosted glass over a deep base — this is what reads as "premium" */
+  background: color-mix(in srgb, var(--surface-1) 82%, transparent);
+  backdrop-filter: saturate(180%) blur(20px);
+  -webkit-backdrop-filter: saturate(180%) blur(20px);
+  border: 1px solid rgba(255, 255, 255, .10);
+  border-radius: 26px;
+  box-shadow:
+    0 1px 0 rgba(255, 255, 255, .16) inset,
+    0 8px 28px rgba(0, 0, 0, .18),
+    0 2px 8px rgba(0, 0, 0, .10);
+
+  transition: transform var(--dur-3) var(--ease-out), opacity var(--dur-2) var(--ease);
+  will-change: transform;
+  contain: layout paint;
+}
+html.dark .tsb-bar {
+  background: color-mix(in srgb, #1A1A1F 78%, transparent);
+  border-color: rgba(255, 255, 255, .09);
+  box-shadow:
+    0 1px 0 rgba(255, 255, 255, .07) inset,
+    0 10px 34px rgba(0, 0, 0, .55),
+    0 2px 10px rgba(0, 0, 0, .40);
+}
+
+/* hide on scroll-down, return on scroll-up */
+.tsb-bar.is-hidden {
+  transform: translateX(-50%) translateY(calc(100% + var(--safe-b) + 22px)) translateZ(0);
+  opacity: 0;
+  pointer-events: none;
+}
+
+.tsb-bar__item {
+  position: relative;
+  flex: 1 1 0;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 3px;
+
+  height: 50px;
+  min-width: 0;
+  padding: 0;
+
+  background: transparent;
+  border: 0;
+  border-radius: 19px;
+  color: var(--text-3);
+  font-family: var(--font-body);
+  font-size: 10px;
+  font-weight: 600;
+  letter-spacing: .1px;
+  text-decoration: none;
+  cursor: pointer;
+  -webkit-tap-highlight-color: transparent;
+
+  transition: color var(--dur-2) var(--ease);
+}
+.tsb-bar__icon {
+  position: relative;
+  z-index: 1;
+  width: 22px; height: 22px;
+  display: grid; place-items: center;
+  flex: 0 0 auto;
+  transition: transform var(--dur-2) var(--ease-spring);
+}
+.tsb-bar__icon svg {
+  width: 22px; height: 22px;
+  stroke-width: 1.9;
+  transition: stroke-width var(--dur-2) var(--ease);
+}
+.tsb-bar__label {
+  position: relative;
+  z-index: 1;
+  max-width: 100%;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  transition: opacity var(--dur-2) var(--ease);
+}
+
+/* the active pill slides behind the icon — one shared element feel */
+.tsb-bar__item::before {
+  content: "";
+  position: absolute;
+  inset: 0;
+  border-radius: 19px;
+  background: var(--tsb-mint);
+  opacity: 0;
+  transform: scale(.7);
+  transition: opacity var(--dur-2) var(--ease),
+              transform var(--dur-3) var(--ease-spring);
+}
+.tsb-bar__item.is-active::before { opacity: 1; transform: scale(1); }
+.tsb-bar__item.is-active {
+  color: var(--tsb-black);
+  font-weight: 700;
+}
+.tsb-bar__item.is-active .tsb-bar__icon { transform: translateY(-1px); }
+.tsb-bar__item.is-active .tsb-bar__icon svg { stroke-width: 2.3; }
+
+.tsb-bar__item:active .tsb-bar__icon { transform: scale(.86); }
+
+@media (hover: hover) {
+  .tsb-bar__item:hover:not(.is-active) { color: var(--text-1); }
+}
+
+/* ADD — the raised coral FAB in the middle slot */
+.tsb-bar__item--fab {
+  flex: 0 0 auto;
+  width: 56px;
+  height: 50px;
+}
+.tsb-bar__item--fab::before { display: none; }
+.tsb-bar__fab {
+  display: grid;
+  place-items: center;
+  width: 48px; height: 48px;
+  background: linear-gradient(160deg, #FF6E5C 0%, var(--tsb-coral) 55%, #E8422E 100%);
+  color: #fff;
+  border: 0;
+  border-radius: 17px;
+  box-shadow:
+    0 1px 0 rgba(255, 255, 255, .28) inset,
+    0 6px 16px rgba(255, 90, 71, .42);
+  transition: transform var(--dur-2) var(--ease-spring), box-shadow var(--dur-2) var(--ease);
+}
+.tsb-bar__item--fab:active .tsb-bar__fab {
+  transform: scale(.9);
+  box-shadow: 0 2px 8px rgba(255, 90, 71, .34);
+}
+.tsb-bar__fab svg { width: 23px; height: 23px; stroke-width: 2.6; }
+
+/* unread dot */
+.tsb-bar__dot {
+  position: absolute;
+  top: 7px;
+  right: calc(50% - 15px);
+  z-index: 2;
+  width: 7px; height: 7px;
+  background: var(--tsb-coral);
+  border: 2px solid var(--surface-1);
+  border-radius: var(--r-pill);
+}
+
+/* the shell reserves room so content never hides behind the bar */
+body.tsb-has-bar { padding-bottom: calc(var(--bar-total) + 24px); }
+
+/* desktop: bar stays (it's the app), just centred and tidier */
+@media (min-width: 900px) {
+  .tsb-bar { width: 520px; }
+}
+
+/* ============================================================
+   TOP APP BAR — small logo + search + bell (Home)
+   ============================================================ */
+.tsb-topbar {
+  position: sticky;
+  top: 0;
+  z-index: var(--z-sticky);
+  display: flex;
+  align-items: center;
+  gap: var(--s-2);
+  padding: calc(var(--safe-t) + var(--s-3)) var(--gutter) var(--s-3);
+  background: color-mix(in srgb, var(--surface-0) 88%, transparent);
+  backdrop-filter: saturate(160%) blur(12px);
+  -webkit-backdrop-filter: saturate(160%) blur(12px);
+  border-bottom: var(--border-soft);
+}
+.tsb-topbar__logo {
+  flex: 0 0 auto;
+  width: 36px; height: 36px;
+  border-radius: var(--r-sm);
+  overflow: hidden;
+}
+.tsb-topbar__logo img { width: 100%; height: 100%; object-fit: cover; }
+
+.tsb-search {
+  flex: 1 1 auto;
+  display: flex;
+  align-items: center;
+  gap: var(--s-2);
+  min-width: 0;
+  height: 42px;
+  padding: 0 var(--s-4);
+  background: var(--surface-inset);
+  border: var(--border-soft);
+  border-radius: var(--r-pill);
+  color: var(--text-3);
+  font-size: var(--fs-sm);
+  cursor: text;
+}
+.tsb-search svg { width: 18px; height: 18px; flex: 0 0 auto; }
+.tsb-search input {
+  flex: 1 1 auto;
+  min-width: 0;
+  background: none;
+  border: 0;
+  outline: none;
+  color: var(--text-1);
+  font-family: var(--font-body);
+  font-size: var(--fs-sm);
+}
+.tsb-search input::placeholder { color: var(--text-3); }
+
+.tsb-iconbtn {
+  flex: 0 0 auto;
+  display: grid;
+  place-items: center;
+  width: 42px; height: 42px;
+  background: var(--surface-inset);
+  border: var(--border-soft);
+  border-radius: var(--r-pill);
+  color: var(--text-1);
+  cursor: pointer;
+  transition: transform var(--dur-2) var(--ease-spring), background var(--dur-2) var(--ease);
+}
+.tsb-iconbtn:active { transform: scale(.94); }
+.tsb-iconbtn svg { width: 20px; height: 20px; }
+
+/* ============================================================
+   COLOUR-BLOCK CARDS — the v2 feed surface
+   ============================================================ */
+.tsb-card {
+  position: relative;
+  display: block;
+  width: 100%;
+  padding: var(--s-5);
+  border-radius: var(--r-lg);
+  background: var(--surface-1);
+  box-shadow: var(--shadow-2);
+  overflow: hidden;
+  text-align: left;
+  transition: transform var(--dur-2) var(--ease-out), box-shadow var(--dur-2) var(--ease);
+}
+.tsb-card:active { transform: scale(.985); }
+
+.tsb-card--coral      { background: var(--tsb-coral);      color: #fff; }
+.tsb-card--periwinkle { background: var(--tsb-periwinkle); color: #fff; }
+.tsb-card--butter     { background: var(--tsb-butter);     color: var(--tsb-black); }
+.tsb-card--mint       { background: var(--tsb-mint);       color: var(--tsb-black); }
+.tsb-card--sky        { background: var(--tsb-sky);        color: var(--tsb-black); }
+.tsb-card--dark       { background: var(--tsb-slate-900);  color: #F5F3EE; }
+
+.tsb-card__eyebrow {
+  font-size: var(--fs-2xs);
+  font-weight: 700;
+  letter-spacing: var(--tracking-caps);
+  text-transform: uppercase;
+  opacity: .72;
+  margin-bottom: var(--s-2);
+}
+.tsb-card__title {
+  font-family: var(--font-head);
+  font-size: var(--fs-xl);
+  line-height: var(--lh-tight);
+  text-transform: uppercase;
+  letter-spacing: var(--tracking-head);
+  margin-bottom: var(--s-2);
+}
+.tsb-card__body { font-size: var(--fs-sm); line-height: var(--lh-snug); opacity: .9; }
+
+/* small circular ↗ action, top-right of a card (reference) */
+.tsb-card__go {
+  position: absolute;
+  top: var(--s-4);
+  right: var(--s-4);
+  display: grid;
+  place-items: center;
+  width: 34px; height: 34px;
+  background: rgba(255,255,255,.92);
+  color: var(--tsb-black);
+  border: 0;
+  border-radius: var(--r-pill);
+  cursor: pointer;
+  transition: transform var(--dur-2) var(--ease-spring);
+}
+.tsb-card__go:active { transform: scale(.9) rotate(8deg); }
+.tsb-card__go svg { width: 16px; height: 16px; stroke-width: 2.5; }
+
+/* pill dropdown chip (reference: "this week ⌄") */
+.tsb-chip {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--s-2);
+  height: 34px;
+  padding: 0 var(--s-4);
+  background: var(--surface-2);
+  border: var(--border-soft);
+  border-radius: var(--r-pill);
+  color: var(--text-1);
+  font-size: var(--fs-xs);
+  font-weight: 600;
+  white-space: nowrap;
+  cursor: pointer;
+}
+.tsb-chip svg { width: 14px; height: 14px; }
+
+/* ============================================================
+   SKELETON LOADERS
+   ============================================================ */
+.tsb-skel {
+  background: linear-gradient(90deg,
+    var(--surface-inset) 25%,
+    color-mix(in srgb, var(--surface-inset) 60%, var(--surface-2)) 37%,
+    var(--surface-inset) 63%);
+  background-size: 400% 100%;
+  animation: tsb-shimmer 1.4s ease infinite;
+  border-radius: var(--r-sm);
+}
+@keyframes tsb-shimmer {
+  0%   { background-position: 100% 50%; }
+  100% { background-position: 0 50%; }
+}
+
+/* ============================================================
+   PAGE SCAFFOLD
+   ============================================================ */
+.tsb-page {
+  width: 100%;
+  max-width: var(--page-max);
+  margin-inline: auto;
+  padding-inline: var(--gutter);
+}
+.tsb-stack   { display: flex; flex-direction: column; gap: var(--s-4); }
+.tsb-stack-6 { display: flex; flex-direction: column; gap: var(--s-6); }
+
+.tsb-section-head {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: var(--s-3);
+  margin: var(--s-8) 0 var(--s-4);
+}
+.tsb-section-head h2 {
+  font-family: var(--font-head);
+  font-size: var(--fs-2xl);
+  line-height: var(--lh-tight);
+  text-transform: uppercase;
+  letter-spacing: var(--tracking-head);
+  color: var(--text-1);
+}
+.tsb-section-head a { font-size: var(--fs-xs); font-weight: 700; color: var(--text-3); text-decoration: none; }
+
+/* horizontal shelf rail (Library) */
+.tsb-rail {
+  display: flex;
+  gap: var(--s-3);
+  overflow-x: auto;
+  scroll-snap-type: x mandatory;
+  -webkit-overflow-scrolling: touch;
+  scrollbar-width: none;
+  padding-bottom: var(--s-2);
+  margin-inline: calc(var(--gutter) * -1);
+  padding-inline: var(--gutter);
+}
+.tsb-rail::-webkit-scrollbar { display: none; }
+.tsb-rail > * { scroll-snap-align: start; flex: 0 0 auto; }
+
+/* ---------- You tab avatar (signed in) ---------- */
+.tsb-bar__ava {
+  width: 22px; height: 22px;
+  border-radius: var(--r-pill);
+  object-fit: cover;
+  display: block;
+}
+.tsb-bar__ava--ini {
+  display: grid;
+  place-items: center;
+  background: var(--tsb-periwinkle);
+  color: #fff;
+  font-family: var(--font-head);
+  font-size: 9.5px;
+  letter-spacing: .3px;
+}
+.tsb-bar__item.is-active .tsb-bar__ava--ini {
+  background: var(--tsb-black);
+}
